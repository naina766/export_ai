# ==============================================================================
# EXPORT AI — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in all placeholder values before running locally or with Docker.
# ==============================================================================

# --- Database (PostgreSQL / Neon) ---
DATABASE_URL=postgresql://export_admin:replace_with_strong_db_password@localhost:5432/export_ai_crm?schema=public

# --- Docker Compose Service Variables ---
POSTGRES_USER=export_admin
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_DB=export_ai_crm

# --- RabbitMQ Message Broker ---
RABBITMQ_URL=amqp://admin:replace_with_strong_rabbitmq_password@localhost:5672
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=replace_with_strong_rabbitmq_password
RABBITMQ_EXCHANGE=export.jobs.exchange
RABBITMQ_DLX=export.dlx

# --- JWT Authentication ---
# MUST be at least 32 characters in production
JWT_SECRET=replace-with-a-random-32-plus-character-secret-key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cryptographic Security ---
# 64 hex characters (32 bytes) for AES-256-GCM token encryption
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
UNSUBSCRIBE_SECRET=replace-with-a-random-32-plus-character-unsubscribe-secret

# --- Application URLs ---
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Google Gemini AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Google OAuth 2.0 / Gmail API ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# --- Cloudinary (Media & Document Storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
